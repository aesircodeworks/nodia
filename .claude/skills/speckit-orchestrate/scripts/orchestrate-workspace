#!/usr/bin/env bash
# Resolve and ensure the working-tree directory this skill uses for its
# artifacts (task briefs, implementer reports, review files, review
# packages, and the progress ledger), namespaced per feature so ledgers
# from different features never collide. Prints the absolute path.
#
# The workspace lives in the working tree (not under .git/) because agent
# writes into .git/ are blocked, which would stop implementer subagents
# from writing their report files. A self-ignoring .gitignore keeps the
# workspace out of git status and out of accidental commits without
# modifying any tracked file.
#
# Usage: orchestrate-workspace [FEATURE_SLUG]
# Default FEATURE_SLUG: current branch name, sanitized. On spec-kit
# feature branches this matches the FEATURE_DIR basename.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
slug=${1:-$(git rev-parse --abbrev-ref HEAD)}
slug=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9._-' '-')

dir="$root/.specify/orchestration/$slug"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
