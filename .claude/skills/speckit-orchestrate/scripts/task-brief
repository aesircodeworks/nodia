#!/usr/bin/env bash
# Extract one task's requirements from a spec-kit tasks.md into a single
# brief file the implementer reads in one call: the task line, its phase
# context, the feature's test policy, resolved excerpts for the design
# references the task text cites (research R-sections, spec FR/NFR/SC
# items, small referenced files such as contracts), and a read-yourself
# list for everything that could not be extracted. Best effort by design:
# an unresolved reference degrades to the read-yourself list, never to
# failure, so any template-conformant tasks.md works.
#
# Usage: task-brief TASKS_FILE TASK_ID [OUTFILE]
# Default OUTFILE: <workspace>/<TASK_ID>-brief.md
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief TASKS_FILE TASK_ID [OUTFILE]" >&2
  exit 2
fi

tasks=$1
id=$2
[ -f "$tasks" ] || { echo "no such tasks file: $tasks" >&2; exit 2; }

feature_dir=$(cd "$(dirname "$tasks")" && pwd)
slug=$(basename "$feature_dir")
root=$(git rev-parse --show-toplevel)
scripts_dir=$(cd "$(dirname "$0")" && pwd)

if [ $# -eq 3 ]; then
  out=$3
else
  out="$("$scripts_dir/orchestrate-workspace" "$slug")/${id}-brief.md"
fi

task_ln=$(grep -nE "^- \[[ xX]\] ${id}([^0-9]|$)" "$tasks" | head -1 | cut -d: -f1 || true)
[ -n "$task_ln" ] || { echo "task ${id} not found in ${tasks}" >&2; exit 1; }
task_line=$(sed -n "${task_ln}p" "$tasks")

phase_start=$(awk -v n="$task_ln" 'NR<=n && /^## /{ln=NR} END{print ln+0}' "$tasks")
phase_ctx=""
if [ "$phase_start" -gt 0 ]; then
  phase_ctx=$(awk -v s="$phase_start" '
    NR==s {print; next}
    NR>s && /^## / {exit}
    NR>s && /^\*\*(Purpose|Goal|Checkpoint|Independent Test)\*\*/
  ' "$tasks")
fi

tests_note=$(grep -m1 '^\*\*Tests\*\*' "$tasks" || true)

tokens=$(printf '%s\n' "$task_line" | tr -cs 'A-Za-z0-9._/-' '\n' | sort -u)
r_ids=$(printf '%s\n' "$tokens" | grep -xE 'R[0-9]+' || true)
req_ids=$(printf '%s\n' "$tokens" | grep -xE '(FR|NFR|SC)-[0-9]+' || true)
file_refs=$(printf '%s\n' "$tokens" | grep -E '\.(md|ya?ml|json)$' || true)

{
  echo "# Task Brief: ${id} (${slug})"
  echo
  echo "## Task"
  echo
  echo "$task_line"
  if [ -n "$phase_ctx" ]; then
    echo
    echo "## Phase Context"
    echo
    echo "$phase_ctx"
  fi
  if [ -n "$tests_note" ]; then
    echo
    echo "## Feature Test Policy"
    echo
    echo "$tests_note"
  fi
} > "$out"

unresolved=""
resolved_any=0

emit() {
  if [ "$resolved_any" -eq 0 ]; then
    { echo; echo "## Resolved References"; } >> "$out"
    resolved_any=1
  fi
  { echo; echo "### $1"; echo; printf '%s\n' "$2"; } >> "$out"
}

for rid in $r_ids; do
  sec=""
  if [ -f "$feature_dir/research.md" ]; then
    sec=$(awk -v tok="$rid" '
      found && ($0 ~ /^#+ / || $0 ~ /^\*\*R[0-9]+[^0-9]/) {exit}
      !found && ($0 ~ ("^#+ .*" tok "([^0-9]|$)") || $0 ~ ("^\\*\\*" tok "([^0-9]|$)")) {found=1}
      found
    ' "$feature_dir/research.md")
  fi
  if [ -n "$sec" ]; then
    emit "research.md ${rid}" "$sec"
  else
    unresolved="${unresolved}${feature_dir}/research.md, section ${rid}"$'\n'
  fi
done

for qid in $req_ids; do
  sec=""
  if [ -f "$feature_dir/spec.md" ]; then
    sec=$(awk -v tok="$qid" '
      index($0, tok) {grab=1; print; next}
      grab && /^[[:space:]]+[^[:space:]]/ {print; next}
      grab {grab=0}
    ' "$feature_dir/spec.md")
  fi
  if [ -n "$sec" ]; then
    emit "spec.md ${qid}" "$sec"
  else
    unresolved="${unresolved}${feature_dir}/spec.md, item ${qid}"$'\n'
  fi
done

for f in $file_refs; do
  case "$(basename "$f")" in
    tasks.md) continue ;;
    research.md) [ -n "$r_ids" ] && continue ;;
    spec.md) [ -n "$req_ids" ] && continue ;;
  esac
  path=""
  for cand in "$feature_dir/$f" "$root/$f"; do
    if [ -f "$cand" ]; then path=$cand; break; fi
  done
  if [ -z "$path" ]; then
    unresolved="${unresolved}${f} (not on disk; either an artifact this task creates or a file to locate yourself)"$'\n'
    continue
  fi
  case "$(basename "$path")" in
    spec.md|plan.md|research.md|data-model.md|quickstart.md)
      unresolved="${unresolved}${path}"$'\n'
      continue ;;
  esac
  if [ "$(wc -l < "$path" | tr -d ' ')" -le 150 ]; then
    emit "$f" "$(cat "$path")"
  else
    unresolved="${unresolved}${path}"$'\n'
  fi
done

if [ -n "$unresolved" ]; then
  {
    echo
    echo "## Read These Yourself"
    echo
    echo "These references bind this task but were not inlined; read them before starting:"
    echo
    printf '%s' "$unresolved" | sort -u | sed 's/^/- /'
  } >> "$out"
fi

echo "wrote ${out}"
