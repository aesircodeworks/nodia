# Root-level environment for the Compose stack (infra/compose/docker-compose.yml).
# `make setup` copies this to `.env` if it does not already exist; `make up`,
# `make down`, and `make fresh` pass it to `docker compose --env-file`. Every
# variable below has a matching ${VAR:-default} in the compose file, so the
# stack runs standalone even without this file; override values here to
# change ports or credentials without touching infra/compose/docker-compose.yml.

# API container
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:+WkHmoGlRETXZ9S8PSOW11+hKN8zZAPMpABqJuK9pNs=
API_PORT=8000
LOG_LEVEL=debug
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local

# PostgreSQL
DB_DATABASE=nodia_api
DB_USERNAME=nodia
DB_PASSWORD=nodia
DB_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=nodia
MINIO_ROOT_PASSWORD=nodia12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=nodia
