# Copied to .env by `make setup` (repo root) if not already present.

# Base URL of the API, exposed by infra/compose/docker-compose.yml's `api`
# service (see the root .env.example's API_PORT). Must be NEXT_PUBLIC_-prefixed
# so Next.js inlines it for client-side fetches, e.g. the health status display.
NEXT_PUBLIC_API_URL=http://localhost:8000
