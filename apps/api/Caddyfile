# FrankenPHP/Octane worker configuration for the containerized API (docs/decisions/009-octane-on-frankenphp.md).
#
# Runs frankenphp directly in worker mode against Octane's worker script, instead of
# through `php artisan octane:frankenphp` (that command is a host-native dev convenience
# wrapper: its Symfony Process layer buffers and discards the worker's stdout instead of
# forwarding it, which would silently swallow the app's structured JSON request logs).

{
	admin localhost:2019
	auto_https disable_redirects

	frankenphp {
		worker {
			file /app/public/frankenphp-worker.php
			num 4
		}
	}
}

:8000 {
	# No site access-log block on purpose: Caddy's `log` directive would emit its
	# own per-request JSON line to stdout, uncorrelated with the app's single
	# request.handled line (CorrelationId middleware). The app owns that one line;
	# Caddy's runtime/error logger is separate and still reaches stderr by default.

	root * /app/public
	encode zstd br gzip

	php_server {
		index frankenphp-worker.php
		try_files {path} frankenphp-worker.php
		resolve_root_symlink
	}
}
